# Resolve installed SDK dependencies only for the platform and compiler that produced the archive.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Preserve the published archive's ABI without downloading dependencies or upgrading compilers.
# Reject cross-platform or compiler-version mixing instead of accepting incompatible Windows/Linux archives.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@")
    set(Comet_FOUND FALSE)
    set(Comet_NOT_FOUND_MESSAGE "This Comet package requires @CMAKE_SYSTEM_NAME@ and @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@")
    return()
endif()
set(ZLIB_USE_STATIC_LIBS ON)
find_dependency(Threads)
find_dependency(Protobuf 36.1.0 EXACT CONFIG)
find_dependency(gRPC 1.84.0 EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/CometTargets.cmake")
check_required_components(Comet)
