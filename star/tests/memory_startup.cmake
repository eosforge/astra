# Exercise the actual Star entry with bounded children and an isolated test-only libc rejection.
if(NOT DEFINED STAR OR NOT DEFINED FAULT OR NOT EXISTS "${STAR}" OR NOT EXISTS "${FAULT}")
    message(FATAL_ERROR "Missing actual Star or allocator fault fixture")
endif()
set(hits 0)
foreach(mode IN ITEMS default environment tunables)
    set(setting)
    if(mode STREQUAL "environment")
        set(setting "MALLOC_ARENA_MAX=4")
    elseif(mode STREQUAL "tunables")
        set(setting "GLIBC_TUNABLES=glibc.malloc.arena_max=4")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=MALLOC_ARENA_MAX --unset=GLIBC_TUNABLES --unset=LD_AUDIT
        "LD_PRELOAD=${FAULT}" ${setting} "${STAR}" --help
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(mode STREQUAL "default")
        if(NOT code STREQUAL "1" OR NOT output STREQUAL "" OR NOT error STREQUAL "STAR-MEMORY-REJECT arena=16\nCannot configure allocator arenas\n")
            message(FATAL_ERROR "Allocator rejection did not stop real Star startup: ${code}; ${output}; ${error}")
        endif()
    else()
        if(NOT code STREQUAL "0" OR NOT error STREQUAL "" OR NOT output MATCHES "--help")
            message(FATAL_ERROR "Explicit allocator setting did not preserve real Star startup: ${mode}; ${code}; ${output}; ${error}")
        endif()
    endif()
    math(EXPR hits "${hits}+1")
    message("STAR-MEMORY-STARTUP ${mode} exit=${code}")
endforeach()
message("ASTRA-CHECKS {\"hits\":${hits}}")
