// Verify malformed pointer inputs before transport normalization, without changing production behavior.
//go:build linux && cgo

package server

import (
	"context"
	"errors"
	"reflect"
	"testing"
	"time"

	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/status"

	"github.com/eosforge/astra/internal/generated/comet"
	"github.com/eosforge/astra/internal/generated/polaris"
	"github.com/eosforge/astra/polaris/internal/storage"
)

// pointers preserves caller-owned pointers; upload's clone models a different transport boundary.
type pointers struct {
	*upload // Retain receipt, context, and unexpected-operation checks.
}

// Recv returns the exact test input without cloning away a nil repeated-message element.
func (wire *pointers) Recv() (*polaris.BatchRequest, error) {
	wire.reads++
	if wire.reads <= len(wire.pages) {
		return wire.pages[wire.reads-1], nil
	}
	return nil, errors.New("unexpected receive after malformed pointer")
}

// TestBatchPointers covers both malformed input domains and proves refusal leaves durable state reusable.
func TestBatchPointers(t *testing.T) {
	t.Parallel()
	for _, name := range []string{"nil", "empty"} {
		t.Run(name, func(t *testing.T) {
			system := environment(t, storage.Default())
			authority, err := NewAuthority(system.store, system.node.Directory(), 256<<20)
			if err != nil {
				t.Fatal(err)
			}
			scope := storage.Scope{Sector: "s", Spectrum: "p"}
			if _, err := system.store.Commit(t.Context(), scope, storage.Change{Version: 1, Key: "keep", Value: []byte("before")}); err != nil {
				t.Fatal(err)
			}
			before, err := system.store.Load(t.Context(), scope)
			if err != nil {
				t.Fatal(err)
			}
			ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
			defer cancel()
			ctx = metadata.NewIncomingContext(ctx, metadata.Pairs("astra-admission-bin", string(system.manager.Admission), "astra-signature-bin", string(system.manager.AdmissionSignature)))
			var entry *comet.AlmanacChange
			if name == "empty" {
				entry = &comet.AlmanacChange{}
			}
			position := &comet.Scope{Sector: []byte("s"), Spectrum: []byte("p")}
			wire := &pointers{upload: &upload{capture: capture{ctx: ctx}, pages: []*polaris.BatchRequest{{Scope: position, Version: 2, Changes: []*comet.AlmanacChange{entry}}}}}
			if err := authority.Batch(wire); status.Code(err) != codes.InvalidArgument || wire.reads != 1 || wire.result != nil || len(authority.slots) != 0 {
				t.Fatalf("refusal: error=%v reads=%d receipt=%v permits=%d", err, wire.reads, wire.result, len(authority.slots))
			}
			after, err := system.store.Load(t.Context(), scope)
			if err != nil || !reflect.DeepEqual(before, after) {
				t.Fatalf("durable state changed: %v %v", after, err)
			}
			result, err := authority.Commit(ctx, &polaris.CommitRequest{Scope: position, Version: 2, Change: &comet.AlmanacChange{Key: "next", Action: &comet.AlmanacChange_Value{Value: []byte("after")}}})
			if err != nil || result.Version != 2 || len(authority.slots) != 0 {
				t.Fatalf("healthy reuse: %v %v", result, err)
			}
		})
	}
}
