{
  "composition": [
    {
      "id": "repeated-statement-recovery",
      "reason": "Two refusal/refusal/recovery cycles at every mutating SQL class complement the retained suite.",
      "requirement": "polaris-storage/DEV-FAULT/STORAGE-SQL-FAULT/linux-amd64-cgo/sql-recovery"
    },
    {
      "id": "repeated-finalization",
      "reason": "Each of six finalization selections fails twice with close/reopen recovery; failed and durable-lost-receipt outcomes remain distinct.",
      "tests": [
        "TestFinalization"
      ]
    },
    {
      "id": "teardown-products",
      "reason": "All eight combinations of read-pool, write-pool and lock-close failures prove later cleanup despite earlier refusal.",
      "tests": [
        "TestTermination"
      ]
    },
    {
      "id": "cancelled-finalization",
      "reason": "Controlled barriers hold actual database/sql background rollback until the operation has demonstrated ownership retention.",
      "tests": [
        "TestDraining/read",
        "TestDraining/write"
      ]
    },
    {
      "id": "opening-recovery",
      "reason": "Separate native-driver children preserve initialization refusal, descriptor-close and parent-directory sync/close failures, including repeated selected failures and retained-cursor cleanup.",
      "tests": [
        "TestWriteFault"
      ]
    }
  ],
  "equivalence": [
    {
      "id": "sql-cut-classes",
      "reason": "Every mutating statement class has its own reached SQL fault and repeated recovery case. Repeated rows using the same statement/error branch do not create additional control-flow classes; partial writes are checked against full durable snapshots."
    },
    {
      "id": "native-driver-boundary",
      "reason": "Pinned SQLite remains real. API and OS receipt faults qualify only their reached storage boundary, never all internal SQLite paths or simulated power-loss durability."
    },
    {
      "id": "finite-products",
      "reason": "Selected critical cancellation/finalization and cleanup products are explicit. This is a finite boundary inventory, not exhaustive enumeration of arbitrary faults in unrelated operations."
    }
  ],
