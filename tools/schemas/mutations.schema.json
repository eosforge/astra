{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "package", "import", "mutations"],
  "properties": {
    "version": {"const": 1},
    "scope": {"type": "string", "minLength": 20},
    "package": {"type": "string", "pattern": "^\\./[a-zA-Z0-9_/]+$"},
    "import": {"type": "string", "minLength": 1},
    "fixtures": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "mutations": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "file", "test", "before", "after"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "file": {"type": "string", "minLength": 1},
          "test": {"type": "string", "pattern": "^Test[A-Za-z0-9_]+$"},
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "description": "Replacement text; empty deletes the uniquely matched nonempty anchor."}
        }
      }
    }
  }
}
