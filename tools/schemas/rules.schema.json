{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra verification rules v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "global": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$"
          },
          "sections": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$"
            },
            "minItems": 0,
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "sections",
          "subject",
          "depends_on"
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "global",
    "rules"
  ]
}
